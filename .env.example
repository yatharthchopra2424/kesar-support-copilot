# Copy to .env and fill in. Never commit .env.
# In n8n, prefer the Credentials manager over typing keys into nodes.

# LLM (primary): Google AI Studio free tier
GEMINI_API_KEY=

# LLM (fallback): OpenRouter
OPENROUTER_API_KEY=

# n8n webhook that receives one email per POST
N8N_WEBHOOK_URL=
# Optional shared secret sent as the X-Webhook-Secret header
N8N_WEBHOOK_SECRET=

# Google Sheet ID of "Kesar Support" (the long id in the sheet URL)
GOOGLE_SHEET_ID=
